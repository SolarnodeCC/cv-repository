{
  "name": "solarnode-cv-site",
  "private": true,
  "scripts": {
    "sync": "node ./scripts/sync-output.mjs",
    "seed-r2": "node ./scripts/seed-r2.mjs",
    "seed-r2:force": "node ./scripts/seed-r2.mjs --force",
    "deploy": "npm run sync && wrangler deploy && npm run seed-r2",
    "dev": "npm run sync && wrangler dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.129.1"
  }
}
