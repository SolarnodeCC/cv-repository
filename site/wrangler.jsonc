{
  "name": "solarnode-cv",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "cv.solarnode.cc",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "CV_DATA",
      "bucket_name": "solarnode-cv-data"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
